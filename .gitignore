# bv (beads viewer) local config and caches
.bv/

# MCP config (contains bearer token; never commit)
.cursor/mcp.json

# Beads migration backups (local, machine-specific)
.beads/backup-before-migrate/

# Beads daemon error output (ephemeral)
.beads/daemon-error

# Agent Mail mailbox (in-workspace STORAGE_ROOT)
.agent_mail_mailbox/

# Agent Mail venv (isolated from project .venv)
.abase/mcp_agent_mail/.abase-venv/

# Framework dev venv (langwatch, mcpevals)
.abase/.venv/

# Integration test work directory (clone + blog build)
.abase/integration-test-tmp/

# Pure temporary files (integration test)
tmp/

# Blog SQLite DB (local)
blog/db.sqlite3

# Coverage
blog/.coverage

# Python bytecode
__pycache__/

# Backup files
*.bak

# Session handover (project-specific, regenerated per session)
.cursor/rules/abase-handover-context.mdc
.cursor/handover-archive/
